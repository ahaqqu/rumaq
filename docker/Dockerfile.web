FROM node:20-slim AS build

WORKDIR /app

# Layer 1: dependencies (cached until lockfiles change)
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund --omit=scripts

# Layer 2: stable configs & templates (rarely change)
COPY index.html ./index.html
COPY vite.config.js ./

# Layer 3: src (changes most frequently)
COPY src/ ./src/

RUN npm run build

FROM nginx:alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY docker/nginx.web.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
