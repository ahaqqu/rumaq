# ──────────────────────────────────────────────
# Worker (backend) — set as secrets
# Copy to worker/.dev.vars for local dev, or use
#   wrangler secret put <NAME>
# ──────────────────────────────────────────────

# Google OAuth 2.0 client ID from Google Cloud Console
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Google OAuth 2.0 client secret from Google Cloud Console
GOOGLE_CLIENT_SECRET=your-client-secret

# Random secret for signing JWTs (generate with: openssl rand -hex 32)
WORKER_JWT_SECRET=change-me-to-a-random-64-char-hex-string

# Encryption key for AI API keys stored at rest.
# Any strong passphrase works; the Worker derives a 256-bit AES key using PBKDF2-SHA256.
# Generate a 64-char hex secret with: openssl rand -hex 32
WORKER_ENCRYPTION_KEY=change-me-to-a-random-64-char-hex-string

# Enable email/password auth for testing ("true" or "false")
EMAIL_AUTH_ENABLED=true

# ──────────────────────────────────────────────
# Frontend build variables
# ──────────────────────────────────────────────

# URL of the deployed Worker used when building the frontend.
# Example: https://api.rumaq.workers.dev or a branch preview URL.
VITE_API_BASE=

# ──────────────────────────────────────────────
# Wrangler auth — source this file before running wrangler:
#   source .env
# ──────────────────────────────────────────────

# Cloudflare API token (instead of running wrangler login)
# Generate at https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=

# Cloudflare account ID (overrides account_id in wrangler.toml)
CLOUDFLARE_ACCOUNT_ID=

# D1 database UUID for production deploys (overrides database_id in wrangler.toml)
CLOUDFLARE_DATABASE_ID=

# Dedicated preview database UUID used by PR preview deployments.
CLOUDFLARE_PREVIEW_DATABASE_ID=

# D1 database name used by deploy-cf.js and deploy.sh (default: rumaq)
D1_DATABASE_NAME=

# Cloudflare Pages project name (default: rumaq)
PAGES_PROJECT_NAME=

# R2 bucket name for receipt images (default: rumaq-receipts)
R2_BUCKET_NAME=


