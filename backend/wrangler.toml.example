name = "api"
main = "src/index.ts"
compatibility_date = "2026-07-10"
compatibility_flags = ["nodejs_compat"]

# Replace with your Cloudflare account_id
account_id = "YOUR_ACCOUNT_ID"

# CORS: allow the Pages frontend origin
[vars]
PAGES_ORIGIN = "https://rumaq.pages.dev"

# D1 database binding
[[d1_databases]]
binding = "DB"
database_name = "rumaq"
database_id = "YOUR_DATABASE_ID"

# R2 bucket binding for receipt images
[[r2_buckets]]
binding = "RECEIPTS"
bucket_name = "rumaq-receipts"

# ── Production cache config (uncomment for wrangler.cloudflare.toml) ──
# [cache]
# enabled = true
#
# [exports.default]
# type = "worker"
#
# [exports.default.cache]
# enabled = false
#
# [exports.CachedApi]
# type = "worker"
#
# [exports.CachedApi.cache]
# enabled = true

# Secrets to set with `wrangler secret put`:
# GOOGLE_CLIENT_ID
# GOOGLE_CLIENT_SECRET
# WORKER_JWT_SECRET
# WORKER_ENCRYPTION_KEY
# EMAIL_AUTH_ENABLED
