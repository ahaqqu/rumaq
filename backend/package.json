{
  "name": "rumaq-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.local.toml",
    "deploy": "wrangler deploy --config wrangler.cloudflare.toml",
    "deploy:prod": "wrangler deploy --config wrangler.cloudflare.toml --env production",
    "db:create": "node ../scripts/deploy/setup-db.js",
    "db:migrate": "wrangler d1 migrations apply rumaq",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/standard-validator": "^0.2.3",
    "hono": "^4.12.28",
    "hono-openapi": "^1.3.1",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260708.1",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0"
  }
}
