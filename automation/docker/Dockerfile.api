FROM node:22-slim AS api

WORKDIR /app

# Layer 1: dependencies (cached until lockfiles change)
COPY package.json package-lock.json ./
COPY frontend/package.json ./frontend/
COPY backend/package.json ./backend/
RUN --mount=type=cache,target=/root/.npm \
  npm install --no-audit --no-fund

# Layer 2: stable configs & migrations (rarely change)
COPY backend/tsconfig.json ./backend/
COPY backend/migrations/ ./backend/migrations/

# Layer 3: test support files (change moderately)
COPY automation/tests/ ./automation/tests/

# Layer 4: backend source (changes most frequently)
COPY backend/src/ ./backend/src/

# Layer 5: build (invalidated when src changes)
RUN cd backend && npx esbuild src/index.ts --bundle --platform=neutral --format=esm --outfile=dist/index.mjs && \
  # Fix hono/logger dynamic import: Miniflare can't handle import(cfWorkers) with a variable specifier.
  # Replace the variable with a string literal so Miniflare recognizes the cloudflare: built-in.
  sed -i 's/await import(cfWorkers)/await import("cloudflare:workers")/' dist/index.mjs

EXPOSE 8787

ENV NODE_ENV=test
ENV TEST_MODE=true

CMD ["node", "automation/tests/support/worker-server.mjs"]
