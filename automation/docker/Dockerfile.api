FROM oven/bun:1.3.14-slim AS api

WORKDIR /app

# Layer 1: dependencies (cached until lockfiles change)
COPY bun.lock package.json ./
COPY frontend/package.json ./frontend/
COPY backend/package.json ./backend/
RUN --mount=type=cache,target=/root/.bun \
  bun install --frozen-lockfile

# Layer 2: stable configs (rarely change)
COPY vite.config.ts ./
COPY backend/vite.config.ts ./backend/
COPY backend/tsconfig.json ./backend/
COPY backend/migrations/ ./backend/migrations/
COPY backend/wrangler.test.toml ./backend/

# Layer 3: test support files (change moderately)
COPY automation/tests/ ./automation/tests/

# Layer 4: backend source (changes most frequently)
COPY backend/src/ ./backend/src/

# Layer 5: build (invalidated when src changes)
RUN bunx vp build backend

EXPOSE 8787

ENV NODE_ENV=test
ENV TEST_MODE=true

CMD ["node", "automation/tests/support/worker-server.mjs"]
