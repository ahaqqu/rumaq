ARG PLAYWRIGHT_VERSION=1.61.1
FROM mcr.microsoft.com/playwright:v1.61.1-jammy

WORKDIR /app

# Layer 1: dependencies (cached until lockfiles change)
COPY package.json package-lock.json ./
COPY worker/package.json worker/package-lock.json ./worker/
RUN npm ci --no-audit --no-fund --omit=scripts
RUN cd worker && npm ci --no-audit --no-fund --omit=scripts

# Layer 2: stable configs & migrations (rarely change)
COPY worker/tsconfig.json ./worker/
COPY worker/migrations/ ./worker/migrations/
COPY automation/playwright.config.js ./playwright.config.js
COPY automation/vitest.config.integration.mjs ./vitest.config.integration.mjs

# Layer 3: app source (changes moderately)
COPY worker/src/ ./worker/src/
COPY src/ ./src/

# Layer 4: tests (changes most frequently)
COPY automation/tests/ ./tests/

ENV TEST_BASE_URL=http://proxy:3000

CMD ["sh", "-c", "npm run test:api && npm run test:e2e && sync"]
