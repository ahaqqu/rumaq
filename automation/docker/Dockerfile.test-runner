ARG PLAYWRIGHT_VERSION=1.61.1
FROM mcr.microsoft.com/playwright:v1.61.1-jammy

WORKDIR /app

# Layer 1: dependencies (cached until lockfiles change)
COPY .npmrc package.json package-lock.json ./
COPY frontend/package.json ./frontend/
COPY backend/package.json ./backend/
RUN --mount=type=cache,target=/root/.npm \
  npm install --no-audit --no-fund --prefer-offline \
  || npm install --no-audit --no-fund --prefer-offline --network-timeout=300000 \
  || (npm cache clean --force && npm install --no-audit --no-fund)

# Layer 2: stable configs & migrations (rarely change)
COPY backend/tsconfig.json ./backend/
COPY backend/migrations/ ./backend/migrations/
COPY automation/playwright.config.js ./automation/playwright.config.js
COPY automation/vitest.config.integration.mjs ./automation/vitest.config.integration.mjs

# Layer 3: app source (changes moderately)
COPY backend/src/ ./backend/src/
COPY frontend/src/ ./frontend/src/

# Layer 4: tests (changes most frequently)
COPY automation/tests/ ./automation/tests/

ENV TEST_BASE_URL=http://proxy:3000

CMD ["sh", "-c", "npm run test:api && npm run test:e2e && sync"]
