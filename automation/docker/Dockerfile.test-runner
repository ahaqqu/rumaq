ARG PLAYWRIGHT_VERSION=1.61.1
FROM mcr.microsoft.com/playwright:v1.61.1-jammy

WORKDIR /app

# Install Bun on top of the Playwright Node image
RUN apt-get update && apt-get install -y --no-install-recommends curl unzip \
  && curl -fsSL https://bun.sh/install | bash \
  && ln -s /root/.bun/bin/bun /usr/local/bin/bun \
  && apt-get purge -y curl unzip \
  && rm -rf /var/lib/apt/lists/*

# Layer 1: dependencies (cached until lockfiles change)
COPY bun.lock package.json ./
COPY frontend/package.json ./frontend/
COPY backend/package.json ./backend/
RUN --mount=type=cache,target=/root/.bun/install/cache \
  bun install --frozen-lockfile

# Layer 2: stable configs & migrations (rarely change)
COPY vite.config.ts ./
COPY backend/vite.config.ts ./backend/
COPY backend/tsconfig.json ./backend/
COPY backend/migrations/ ./backend/migrations/
COPY automation/playwright.config.js ./automation/playwright.config.js
COPY automation/vitest.config.integration.mjs ./automation/vitest.config.integration.mjs

# Layer 3: app source (changes moderately)
COPY backend/src/ ./backend/src/
COPY frontend/src/ ./frontend/src/

# Layer 4: tests (changes most frequently)
COPY automation/tests/ ./automation/tests/

ENV TEST_BASE_URL=http://proxy:3000

# Pre-generate Playwright-BDD tests so the output is part of the image. This
# avoids regenerating them on every test run and makes `bunx playwright test`
# discover tests immediately.
RUN bunx bddgen test --config automation/playwright.config.js

CMD ["sh", "-c", "bun x vitest run --config automation/vitest.config.integration.mjs && bun x playwright test --config automation/playwright.config.js && sync"]
